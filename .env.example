# ==============================================================================
# GTM Outreach AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual API keys:
# cp .env.example .env

# --- LLM Providers (At least one required; both enable Ensemble Mode) ---
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Get at: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# --- Web Intelligence & Real-time Search ---
# Exa AI API Key (Get at: https://exa.ai/)
EXA_API_KEY=your_exa_api_key_here

# --- Optional Local Model Configurations (Hybrid Mode) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
